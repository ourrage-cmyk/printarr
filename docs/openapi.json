            "title": "Template Id"
          },
          "decorations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Decorations"
          },
          "selection": {
            "type": "string",
            "enum": [
              "explicit",
              "model",
              "rule"
            ],
            "title": "Selection"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
