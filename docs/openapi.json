        "properties": {
          "recipient": {
            "type": "string",
            "enum": [
              "yannic",
              "wife"
            ],
            "title": "Recipient",
            "description": "A fixed recipient: yannic or wife."
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "examples": [
              "Dinner"
            ]
          },
          "sender": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Sender",
            "description": "Who asked for the ticket, for the log. For example home-assistant or hermes.",
            "examples": [
              "home-assistant"
            ]
          },
          "template": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Template",
            "description": "Template id from GET /api/v1/templates. Must belong to the recipient's group."
          },
          "send_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Send At",
            "description": "When to print, as ISO 8601. Values without a timezone use the server's PRINTARR_TIMEZONE. Omit to print as soon as possible.",
            "examples": [
              "2026-10-24T17:30:00"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recipient",
          "message"
        ],
        "title": "TicketCreate"
