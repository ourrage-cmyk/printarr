        "type": "object",
        "required": [
          "id",
          "recipient",
          "sender",
          "title",
          "message",
          "status",
          "send_at",
          "next_attempt_at",
          "attempts",
          "last_error",
          "template_id",
          "decorations",
          "selection",
          "created_at",
