          "tickets"
        ],
        "summary": "List Tickets",
        "operationId": "list_tickets_api_v1_tickets_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "pending",
                    "printing",
                    "sent",
                    "failed",
                    "cancelled"
